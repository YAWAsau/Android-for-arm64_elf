#~ msgid ""
#~ "\n"
#~ "Handling of file attributes:\n"
#~ "      --owner=NAME             force NAME as owner for added files\n"
#~ "      --group=NAME             force NAME as group for added files\n"
#~ "      --mode=CHANGES           force (symbolic) mode CHANGES for added "
